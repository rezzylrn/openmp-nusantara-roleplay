	}
	return 1;
}

stock InvTextDraw_Update(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS) return 0;

	// Update player name header
	new nameStr[MAX_PLAYER_NAME];
	GetPlayerName(playerid, nameStr, sizeof(nameStr));
	PlayerTextDrawSetString(playerid, INVNAME[playerid][1], nameStr);

	// Update slots & calculate total weight
	new Float:totalWeight = 0.0;
	new itemStr[32], amtStr[16];

	for (new s = 0; s < 25; s++) {
		new iType = gPlayerItems[playerid][s][itType];
		new iAmt = gPlayerItems[playerid][s][itAmount];

		if (iType != ITEM_NONE && iAmt > 0) {
			totalWeight += float(iAmt) * GetItemWeight(iType);

			GetItemName(iType, itemStr, sizeof(itemStr));
			PlayerTextDrawSetString(playerid, NAMETD[playerid][s], itemStr);

			format(amtStr, sizeof(amtStr), "%dx", iAmt);
			PlayerTextDrawSetString(playerid, AMOUNTTD[playerid][s], amtStr);

			PlayerTextDrawSetPreviewModel(playerid, MODELTD[playerid][s], GetItemModel(iType));

			// Highlight slot terpilih (warna cyan terang bila dipilih)
			if (s == gSelectedInvSlot[playerid]) {
				PlayerTextDrawColour(playerid, INDEXTD[playerid][s], 0x33CCFFFF);
			} else {
				PlayerTextDrawColour(playerid, INDEXTD[playerid][s], 825639679);
			}
		} else {
			PlayerTextDrawSetString(playerid, NAMETD[playerid][s], "_");
			PlayerTextDrawSetString(playerid, AMOUNTTD[playerid][s], "_");
			PlayerTextDrawSetPreviewModel(playerid, MODELTD[playerid][s], 0);

			if (s == gSelectedInvSlot[playerid]) {
				PlayerTextDrawColour(playerid, INDEXTD[playerid][s], 0x33CCFFFF);
			} else {
				PlayerTextDrawColour(playerid, INDEXTD[playerid][s], 825639679);
			}
		}
	}

	// Update weight label & progress bar
	new weightStr[32];
	format(weightStr, sizeof(weightStr), "%.1f/50.0kg", totalWeight);
	PlayerTextDrawSetString(playerid, INVNAME[playerid][4], weightStr);

	new Float:barWidth = 214.0 * (totalWeight / 50.0);
	if (barWidth > 214.0) barWidth = 214.0;
	if (barWidth < 0.0) barWidth = 0.0;
	PlayerTextDrawTextSize(playerid, INVNAME[playerid][3], barWidth, 6.000);
	return 1;
}
