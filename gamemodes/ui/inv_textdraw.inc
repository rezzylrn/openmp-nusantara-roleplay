	PlayerTextDrawBackgroundColour(playerid, AMOUNTTD[playerid][24], 150);
	PlayerTextDrawFont(playerid, AMOUNTTD[playerid][24], t_TEXT_DRAW_FONT:1);
	PlayerTextDrawSetProportional(playerid, AMOUNTTD[playerid][24], bool:1);
	return 1;
}

stock InvTextDraw_Destroy(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS) return 0;
	for (new i = 0; i < 5; i++) {
		if (INVNAME[playerid][i] != INVALID_PLAYER_TEXT_DRAW) {
			PlayerTextDrawDestroy(playerid, INVNAME[playerid][i]);
			INVNAME[playerid][i] = INVALID_PLAYER_TEXT_DRAW;
		}
	}
	for (new i = 0; i < 11; i++) {
		if (INVINFO[playerid][i] != INVALID_PLAYER_TEXT_DRAW) {
			PlayerTextDrawDestroy(playerid, INVINFO[playerid][i]);
			INVINFO[playerid][i] = INVALID_PLAYER_TEXT_DRAW;
		}
	}
	for (new i = 0; i < 25; i++) {
		if (INDEXTD[playerid][i] != INVALID_PLAYER_TEXT_DRAW) {
			PlayerTextDrawDestroy(playerid, INDEXTD[playerid][i]);
			INDEXTD[playerid][i] = INVALID_PLAYER_TEXT_DRAW;
		}
		if (MODELTD[playerid][i] != INVALID_PLAYER_TEXT_DRAW) {
			PlayerTextDrawDestroy(playerid, MODELTD[playerid][i]);
			MODELTD[playerid][i] = INVALID_PLAYER_TEXT_DRAW;
		}
		if (NAMETD[playerid][i] != INVALID_PLAYER_TEXT_DRAW) {
			PlayerTextDrawDestroy(playerid, NAMETD[playerid][i]);
			NAMETD[playerid][i] = INVALID_PLAYER_TEXT_DRAW;
		}
		if (AMOUNTTD[playerid][i] != INVALID_PLAYER_TEXT_DRAW) {
			PlayerTextDrawDestroy(playerid, AMOUNTTD[playerid][i]);
			AMOUNTTD[playerid][i] = INVALID_PLAYER_TEXT_DRAW;
		}
	}
	return 1;
}

stock InvTextDraw_Show(playerid)
{
	if (playerid < 0 || playerid >= MAX_PLAYERS) return 0;
	InvTextDraw_Update(playerid);

	for (new i = 0; i < 5; i++) PlayerTextDrawShow(playerid, INVNAME[playerid][i]);
	for (new i = 0; i < 11; i++) PlayerTextDrawShow(playerid, INVINFO[playerid][i]);
	for (new i = 0; i < 25; i++) {
		PlayerTextDrawShow(playerid, INDEXTD[playerid][i]);
		PlayerTextDrawShow(playerid, MODELTD[playerid][i]);
		PlayerTextDrawShow(playerid, NAMETD[playerid][i]);
		PlayerTextDrawShow(playerid, AMOUNTTD[playerid][i]);
	}
	return 1;
}

stock InvTextDraw_Hide(playerid)
{
